{
  "name": "magic-tools",
  "version": "0.2.2",
  "private": true,
  "description": "Obsidian plugin: OCR + export selection to PDF",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --format=cjs --target=es2020 --platform=browser --outfile=main.js --external:obsidian",
    "test": "vitest run",
    "version:sync": "node scripts/sync-version.mjs",
    "version:patch": "pnpm version patch --no-git-tag-version && pnpm version:sync",
    "version:minor": "pnpm version minor --no-git-tag-version && pnpm version:sync",
    "version:major": "pnpm version major --no-git-tag-version && pnpm version:sync"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
